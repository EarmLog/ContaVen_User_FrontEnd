{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "principal",
  "description": "Permisos básicos para que la app local funcione con SQLite y el sistema de archivos.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-close",
    "sql:allow-select"
  ]
}
