{
  "name": "contaven-user-frontend",
  "private": true,
  "version": "1.1.0",
  "description": "ContaVen - App de usuarios (inventario, punto de venta y análisis) con Next.js y soporte offline",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve out",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win portable",
    "tauri": "tauri",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "lint": "oxlint"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "dexie": "^4.0.11",
    "next": "^15.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.contaven.app",
    "productName": "ContaVen",
    "copyright": "ContaVen",
    "directories": {
      "output": "release-electron",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ContaVen-${version}-Windows-Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "author": "ContaVen"
}
